# Deployer key (pays gas in USDC on Arc; holds UPGRADER_ROLE for upgrades)
DEPLOYER_PRIVATE_KEY=
# Optional: separate key for upgrades or admin actions
UPGRADER_PRIVATE_KEY=
ADMIN_PRIVATE_KEY=

# Contract roles / config
ADMIN=
UPGRADER=
MINTER=
REVENUE_WALLET=

# Arc RPC Endpoints
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# Canonical USDC Predeploy Address (identical on testnet & mainnet)
CANONICAL_USDC=0x3600000000000000000000000000000000000000

# Mainnet safety gate (must be "true" to broadcast mainnet deploy; Arc mainnet transactions move real USDC)
CONFIRM_MAINNET=

# For upgrade / smoke scripts
PROXY_ADDRESS=
# Optional: set to 1 to allow mint smoke on testnet
MINT_SMOKE=
