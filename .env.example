# Deployer key (pays gas; should hold DEFAULT_ADMIN_ROLE or be able to pass admin)
DEPLOYER_PRIVATE_KEY=

# Contract roles / config
ADMIN=
MINTER=
REVENUE_WALLET=

# RPCs
BOT_TESTNET_RPC=https://rpc.bohr.life
BOT_MAINNET_RPC=https://rpc.botchain.ai

# Mainnet safety gate (must be "true" to broadcast mainnet deploy)
CONFIRM_MAINNET=

# For upgrade / smoke scripts
PROXY_ADDRESS=
# Optional: set to 1 to allow mint smoke on testnet
MINT_SMOKE=
